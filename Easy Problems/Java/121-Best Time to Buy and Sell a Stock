class Solution {
    public int maxProfit(int[] prices) {

        int left = 0, right = 1;
        int max = 0, currentMax = 0;
        while(right < prices.length)
        {
            //when right runs out of bounds as it'll be moving the furthest, end the loop
            if(prices[left] > prices[right])
            {
                //we set left to this new low (what right currently is) and move right +1
                left = right;
                right++;
            }
            else
            {
                currentMax = prices[right] - prices[left];
                max = Math.max(currentMax, max);
                right++;
                //calculate the subtraction, then compare that and the max and hold the max
            }
        }
        return max;
    }
}
