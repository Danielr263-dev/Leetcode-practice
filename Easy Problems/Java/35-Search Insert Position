class Solution {
    public int searchInsert(int[] nums, int target) {

        /*int low = 0;
        int high = nums.length-1;
        int mid = (low+high)/2;
        for(int i = low; i < high; i++)
        {
            if(target < nums[mid])
            {
                high = mid;
                mid = (low+high)/2;
            }

            else if(target > nums[mid])
            {
                low = mid;
                mid = (low+high)/2;
            }

        }
        return mid;
        */

        int left = 0;
        int right = nums.length - 1;

        while(left <= right)
        {
            //right (high) should not be lower than left (low), if so, terminate loop 
            int mid = left + (right - left)/2;
            /* best way to calculate mid, compensates for when the range gets cut in half and moves left up (and makes sure no big int addition issue happens)*/

            if(nums[mid] == target)
                return mid; //return if found
            else if (nums[mid] > target)
                right = mid - 1;
            else
                left = mid + 1;
            //no point in checking mid itself if its >/< that's why +1/-1
        }
        return left;
        //will return where target is or where it should be 
    }
}