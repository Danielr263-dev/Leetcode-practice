class Solution {
    public int evalRPN(String[] tokens) {
        Stack<Integer> stack = new Stack<>();//new stack to store ints
        int a = 0;
        int b = 0;
        for(int i = 0; i < tokens.length; i++)
        {
            //assuming there will never be operation signs without having the appropriate numbers to do it
            /*push onto stack if reg nums, if any op, do the op and push result back into stack. stack should have only 1 val at end, pop it and return it for the result */
            if(tokens[i].equals("+"))
            {
                a = stack.pop();
                b = stack.pop();
                stack.push(b+a);
            }
            else if(tokens[i].equals("-"))
            {
                a = stack.pop();
                b = stack.pop();
                stack.push(b-a);
            }
            else if(tokens[i].equals("*"))
            {
                a = stack.pop();
                b = stack.pop();
                stack.push(b*a);
            }
            else if(tokens[i].equals("/"))
            {
                a = stack.pop();
                b = stack.pop();
                stack.push(b/a);
            }
            else
            {
                stack.push(Integer.parseInt(tokens[i]));
            }
        }
        int answer = stack.pop();
        return answer;
    }
    /*given an array of strings that represents an arithmetc expression in reverse polish notation (aka postfix notation, where the first math op takes the latest 2 nums and evals like that). evaluate the expression, return an int that represents the val of the expression. valid ops are +, -, *, /, division between operations always truncates toward 0 (nothing after decimal)*/

