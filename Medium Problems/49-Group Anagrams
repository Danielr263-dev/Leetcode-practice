class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        /*each string will be broken down into char array, sorted, 
        and then compared against a hashmap to see if we've seen this
        string before. If not, add to hashmap and a val, which will 
        represent the location in the array of arrays, where matching
        anagrams will be. If so, get the val of the word(key) in the
        hashmap, and at that val in the array of arrays, is where
        we'll add this other matching anagram.*/

        HashMap<String, ArrayList<String>> tony = new HashMap<>();
        /*instead of creating separate list or array where answer will go, 
        why not have the hashmap be the answer where matching anagrams
        get put together */

        for(int i = 0; i < strs.length; i++)
        {
            //loop through all strings
            char temp[] = strs[i].toCharArray();
            //create temp char array to hold string
            Arrays.sort(temp);
            //sort char array, to be used as the comparison and key for hashmap
            String key = new String(temp);
            //turn temp back into string, now sorted
            if(!tony.containsKey(key))
            {
                //if key not contained, add key + new empty array to hashmap
                tony.put(key, new ArrayList<>());
                tony.get(key).add(strs[i]);
                //get array from key, and insert unsorted string to it
            }
            else
            {
                //otherwise if sorted key already exists in hashmap...
                tony.get(key).add(strs[i]);
                /*get array from key, add unsorted string to it to group
                it with the other anagram(s) */
            }
        }
        List<List<String>> answer = new ArrayList<>();
        //creates arraylist in format expected to be returned
        answer.addAll(tony.values());
        //adds only values of hashmap to arraylist
        return answer;    
    }
}
